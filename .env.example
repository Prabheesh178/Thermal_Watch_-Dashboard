# Thermal Watch Dashboard Environment Configuration
# Copy this file to `.env.local` for local development, or configure `VITE_API_URL`
# in your Vercel / Netlify project environment variables.

# Base URL of the Industrial Fire & Persistent Thermal Source Detection FastAPI backend
# Local development default:
VITE_API_URL=http://localhost:8000

# Production Render deployment example:
# VITE_API_URL=https://industrial-fire-detection-api.onrender.com

